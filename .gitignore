# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Installation / run artefacts
install.log

# Barnes UI projects. These contain copies of imported CAD and solver run output,
# so they are large and are the user's data rather than source.
*.barnesproj/

# Solver scratch. Kept out of the tree anyway (see core/logging_setup.py for why
# OneDrive and generated files do not mix), but ignored here as a second line of
# defence in case someone redirects it.
scratch/
runs/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# Solver run logs: the per-mesh JSON summaries are the evidence worth keeping;
# the console transcript is reproducible from the archived run directory.
results/**/*.log

# Screenshots from scripts/visual_check.py. Regenerated in about ninety seconds by
# one command, several megabytes a set, and they change whenever Qt, the system
# theme or any panel does -- so committing them means binary churn on every UI
# edit for evidence nobody can diff. The JSON summaries elsewhere under results/
# are kept because re-running a mesh study costs hours; re-running this does not.
results/visual/

# In-progress claim files written by the A8 study runner
results/**/*.claim
TYPE B/round2/fea/campaign.log
